# Phase B — Supabase access-key activation
# Copy this file to `.env.local` and fill in real values from your Supabase project
# (Settings → API). Without these, the app runs in local-only mode with no gate.

# Example: https://abcd1234.supabase.co
VITE_SUPABASE_URL=

# The "anon" public key is safe for the browser — Row Level Security + the
# security-definer activate_access_key() RPC protect the data behind it.
# NEVER put the service_role key in the client.
VITE_SUPABASE_ANON_KEY=

# The current owner/admin access key used by scripts/ and local verification tools.
# Required only for the verification scripts; the app itself does not need this.
# Rotate via: ROTATE_OLD_OWNER_KEY=<current> node scripts/rotate-owner-key.cjs
# NEVER commit this file — .env.local is gitignored.
# VERIFY_OWNER_KEY=
